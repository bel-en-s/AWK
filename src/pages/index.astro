---
import Layout from "../layouts/Layout.astro";
import Loader from "../components/global/Loader.jsx";
import Hero from "../components/Hero.jsx";
import WorksPreview from "../components/WorksPreview.jsx"
import Footer from "../components/global/Footer.jsx";
import FeaturedLinks from "../components/FeaturedLinks.jsx";
import InfiniteLogoMarquee from "../components/UI/InfiniteLogoMarquee.jsx"
---

<Layout title="Landing AWK" desc="Landing animada con Astro + React + GSAP">
  <Loader client:load />
  <Hero client:load />
  <WorksPreview client:load/>
  <InfiniteLogoMarquee client:load bg="dark" fade />
  <FeaturedLinks client:load />
  <Footer client:load />
</Layout>
