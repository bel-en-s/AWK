---
import "../styles/global.css";
import LenisSmoothScroll from "../scripts/lenis.jsx";
import TransitionBlocks from "../components/global/TransitionBlocks.jsx";
import NavBar from "../components/global/Navbar.jsx";
import Loader from "../components/global/Loader.jsx";
import { ClientRouter } from "astro:transitions";

const { title = "AWK", desc = "" } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="./images/ojos.svg" />

    <title>{title}</title>
    {desc ? <meta name="description" content={desc} /> : null}

    <ClientRouter />
  </head>

  <body>
    <TransitionBlocks client:load transition:persist="trb" />
    <LenisSmoothScroll client:load transition:persist="lenis" />

    <Loader client:load transition:persist="loader" />

    <NavBar client:load transition:persist="nav" />

    <slot />

    <script is:inline>
      const KEY = "AWK_NAV_KIND";
      try { sessionStorage.setItem(KEY, sessionStorage.getItem(KEY) || "hard"); } catch(e) {}

      document.addEventListener("astro:before-swap", () => {
        try { sessionStorage.setItem(KEY, "spa"); } catch(e) {}
      });

      document.addEventListener("astro:after-swap", () => {
        try { sessionStorage.setItem(KEY, "spa"); } catch(e) {}
      });

      // ✅ HARD REFRESH: siempre arrancar arriba (evita que se "rompa" el pin/ScrollTrigger)
      try {
        if ("scrollRestoration" in history) history.scrollRestoration = "manual";
      } catch(e) {}

      const forceTop = () => {
        try {
          // doble rAF: le gana a restauraciones tardías del browser/paint
          requestAnimationFrame(() => {
            window.scrollTo(0, 0);
            requestAnimationFrame(() => window.scrollTo(0, 0));
          });
        } catch(e) {}
      };

      // pageshow cubre BFCache + reloads en algunos browsers
      window.addEventListener("pageshow", forceTop);

      // astro:page-load ocurre después de mount; lo reforzamos igual
      document.addEventListener("astro:page-load", forceTop);
    </script>
  </body>
</html>
