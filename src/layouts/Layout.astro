---
import "../styles/global.css";
import LenisSmoothScroll from "../scripts/lenis.jsx";
const { title, desc } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title || "AWAKE Landing"}</title>
    {desc ? <meta name="description" content={desc} /> : null}
  </head>

  <body>
    <LenisSmoothScroll client:load />
    <slot />
  </body>
</html>
