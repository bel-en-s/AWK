---
import "../styles/global.css";
import LenisSmoothScroll from "../scripts/lenis.jsx";
import TransitionBlocks from "../components/global/TransitionBlocks.jsx";
import NavBar from "../components/global/Navbar.jsx";
import { ClientRouter } from "astro:transitions";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ClientRouter />
  </head>

  <body>
    <TransitionBlocks client:load transition:persist="trb" />
    <LenisSmoothScroll client:load transition:persist="lenis" />
    <NavBar client:load transition:persist="nav" />
    <slot />
  </body>
</html>
