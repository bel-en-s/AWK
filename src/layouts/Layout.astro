---
export interface Props {
  title?: string;
  desc?: string;
}

const { title = "AWK Landing", desc = "Sitio con Astro + React + GSAP" } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />

    <link rel="stylesheet" href="/styles/global.css" />
  </head>

  <body>
    <slot />
  </body>
</html>
